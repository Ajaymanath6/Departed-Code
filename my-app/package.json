{
  "name": "my-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "env -u NODE_PATH node ./node_modules/@angular/cli/bin/ng.js",
    "doctor": "node ./scripts/check-node-env.js",
    "start": "env -u NODE_PATH node ./node_modules/@angular/cli/bin/ng.js serve --port 4202",
    "build": "env -u NODE_PATH node ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "env -u NODE_PATH node ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "env -u NODE_PATH node ./node_modules/@angular/cli/bin/ng.js test",
    "clean": "rm -rf node_modules .angular dist && npm ci",
    "reinstall": "npm run clean"
  },
  "private": true,
  "engines": {
    "node": ">=18.13.0 <21.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@angular/animations": "15.2.10",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@angular/router": "15.2.10",
    "echarts": "^5.5.0",
    "flowbite": "^2.2.0",
    "flowbite-datepicker": "^1.3.2",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "15.2.10",
    "@angular/cli": "15.2.10",
    "@angular/compiler-cli": "15.2.10",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.4",
    "typescript": "4.9.5"
  }
}
